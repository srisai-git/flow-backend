# FocusFlow Backend Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flow
DB_USER=root
DB_PASS=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=80
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/flow_backend

# Groot AI Engine
GROOT_AI_HOST=127.0.0.1
GROOT_AI_PORT=8000
GROOT_AI_MODEL=groot-llama-3.2-1b
GROOT_AI_TIMEOUT=15

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=your_firebase_server_key_here
FCM_SENDER_ID=your_firebase_sender_id_here

# Security & CORS
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
