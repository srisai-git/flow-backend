                "setup_table.php"
              ]
            },
            "description": "Verifies or creates the user_preferences table."
          },
          "response": []
        },
        {
          "name": "Save Routine Preferences",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Preferences saved successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(true);",
                  "    pm.expect(jsonData.data.user_id).to.eql(Number(pm.collectionVariables.get(\"user_id\") || 3));",
                  "    pm.expect(jsonData.data.primary_goal).to.eql(\"Work\");",
                  "    pm.expect(jsonData.data.preferred_focus_duration).to.eql(45);",
                  "    pm.expect(jsonData.data.daily_focus_goal_minutes).to.eql(210);",
                  "    pm.expect(jsonData.data.reminders_enabled).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"name\": \"Sai Kumar\",\n  \"primary_goal\": \"Work\",\n  \"preferred_focus_duration\": 45,\n  \"daily_focus_goal_minutes\": 210,\n  \"reminders_enabled\": 1,\n  \"reminder_time\": \"09:00 AM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
