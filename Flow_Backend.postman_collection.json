              "raw": "{{base_url}}/preferences/save_preferences.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "preferences",
                "save_preferences.php"
              ]
            },
            "description": "Saves or updates daily routine preferences and optionally updates the user display name."
          },
          "response": []
        },
        {
          "name": "Get Routine Preferences (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Routine preferences retrieved\", function () {",
                  "    var jsonData = pm.response.json();",
