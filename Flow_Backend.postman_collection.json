                  "    pm.expect(jsonData.data).to.have.property(\"preferred_focus_duration\");",
                  "    pm.expect(jsonData.data).to.have.property(\"daily_focus_goal_minutes\");",
                  "    pm.expect(jsonData.data).to.have.property(\"reminders_enabled\");",
