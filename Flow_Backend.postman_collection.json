            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "id",
                  "value": "{{user_id}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/profile/get_profile.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "profile",
                "get_profile.php"
              ]
            },
            "description": "Fetches profile data by user ID using HTTP POST with application/x-www-form-urlencoded."
          },
          "response": []
        }
      ]
    },
