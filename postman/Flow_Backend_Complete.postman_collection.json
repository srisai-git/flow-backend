  "item": [
    {
      "name": "1. System & Migrations",
      "item": [
        {
          "name": "Run Database Migrations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All tables created/verified\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(true);",
                  "    pm.expect(json.data.tables_checked).to.include.members(['user_preferences', 'tasks', 'focus_sessions', 'app_settings']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/run_migrations.php",
              "host": ["{{base_url}}"],
              "path": ["run_migrations.php"]
            },
            "description": "Self-executes idempotent migrations to create/verify all database tables."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Signup (Register User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Registration successful with user_id\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(true);",
                  "    pm.expect(json).to.have.property(\"user_id\");",
                  "    if (json.user_id) {",
                  "        pm.collectionVariables.set(\"user_id\", String(json.user_id));",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sai Kumar\",\n  \"email\": \"sai_dev@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/signup.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup.php"]
            }
          },
          "response": []
